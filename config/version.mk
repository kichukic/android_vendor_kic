KIC_VERSION_MAJOR := 1
KIC_VERSION_MINOR := 0
KIC_VERSION := $(KIC_VERSION_MAJOR).$(KIC_VERSION_MINOR)
KIC_BUILD_DATE := $(shell date -u +%Y%m%d)
ifeq ($(WITH_GMS),true)
KIC_VARIANT := GApps
else
KIC_VARIANT := Vanilla
endif
KIC_DISPLAY_VERSION := KIC-OS-$(KIC_VERSION)-$(KIC_BUILD_DATE)-$(KIC_VARIANT)
